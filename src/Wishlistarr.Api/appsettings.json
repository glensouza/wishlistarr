{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Logs": {
    "Capacity": 1000
  },
  "Health": {
    "CacheDuration": "00:00:30",
    "CheckTimeout": "00:00:08"
  },
  "Metrics": {
    "Enabled": false
  },
  "Auth": {
    "TrustedNetworkBypass": false,
    "TrustedNetworks": [],
    "TrustedHosts": [],
    "KnownProxies": []
  },
  "Backups": {
    "Retention": 7
  }
}
